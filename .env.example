# Schulkasse configuration (F12.1). Copy to .env and adjust.
# chmod 600 .env - the secret key must not be readable by other users.

# SQLite database file (directory must be writable by the service user)
SCHULKASSE_DB=/opt/schulkasse/instance/schulkasse.sqlite3

# Random secret, e.g.: python3 -c "import secrets; print(secrets.token_hex(32))"
# Required, at least 32 characters. Also encrypts 2FA secrets: keep this key
# unchanged across restarts/updates and back it up separately and securely.
SCHULKASSE_SECRET_KEY=

# Receipts (Belege) and backups
SCHULKASSE_UPLOAD_DIR=/opt/schulkasse/instance/belege
SCHULKASSE_BACKUP_DIR=/opt/schulkasse/instance/backups

# Maximum upload size in MB (CAMT/ZIP files, receipts)
SCHULKASSE_MAX_UPLOAD_MB=20

# Matching: suggestions with at least this confidence are booked without confirmation (F4.3)
SCHULKASSE_MATCHING_SCHWELLE=100

# Anonymisation: days after project closing
# [PLATZHALTER: Frist nach Abstimmung mit dem Datenschutzbeauftragten, Vorschlag 2 Jahre]
SCHULKASSE_ANONYMISIERUNG_FRIST_TAGE=730

# Letter settings (letterhead, texts), see brief.example.toml
SCHULKASSE_BRIEF_CONFIG=/opt/schulkasse/instance/brief.toml

# Cookies only via HTTPS (keep 1 in production; 0 only for local tests without TLS)
SCHULKASSE_COOKIE_SECURE=1

# Running behind nginx: take client IP from X-Forwarded-For (for the login lockout)
SCHULKASSE_HINTER_PROXY=1

# Local port of the app server (gunicorn listens on 127.0.0.1 only; nginx forwards to it)
SCHULKASSE_PORT=5015
